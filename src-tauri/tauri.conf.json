{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "냥냥",
  "version": "1.0.1",
  "identifier": "com.chaamuchannel.nyangnyang",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "냥냥",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "shortDescription": "오프라인 고양이 건반과 MML 작곡 도구",
    "longDescription": "인터넷 연결 없이 건반을 연주하고 MML 프로젝트를 편집·재생·저장할 수 있는 앱입니다.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
